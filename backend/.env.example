# Copy to .env or export as environment variables before starting the API.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:6230
Database__Provider=PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=demsew_portfolio;Username=postgres;Password=replace-with-your-local-postgres-password
Jwt__Issuer=DemsewPortfolio.Api
Jwt__Audience=DemsewPortfolio.Frontend
# Generate with: openssl rand -base64 48
Jwt__Secret=replace-with-a-random-secret-at-least-32-bytes-long
Admin__Email=admin@example.com
# Use a unique password with 12+ characters, uppercase, lowercase, digit and symbol.
Admin__Password=replace-this-with-a-strong-password
RequireAdminCredentials=true
Frontend__Origin=http://localhost:3000
# Optional SMTP settings for message email notifications
Email__SmtpHost=
Email__Port=587
Email__EnableSsl=true
Email__Username=
Email__Password=
Email__From=
Email__To=
