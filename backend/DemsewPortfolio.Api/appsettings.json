{
  "Database": {
    "Provider": "PostgreSQL"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=demsew_portfolio;Username=postgres;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "DemsewPortfolio.Api",
    "Audience": "DemsewPortfolio.Frontend",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Frontend": {
    "Origin": "http://localhost:3000"
  },
  "RequireAdminCredentials": true,
  "Email": {
    "Port": 587,
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
